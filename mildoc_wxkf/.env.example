# mildoc wxkf - 微信问答接口配置

# ============================================
# 企业微信应用配置
# ============================================
CORP_ID=<你的企业微信 CorpID>
AGENT_ID=<你的自建应用 AgentId>
APP_SECRET=<你的自建应用 Secret>
TOKEN=<自定义一个随机字符串，用于回调验证>
ENCODING_AES_KEY=<自定义一个43位随机字符串，用于消息加解密>

# ============================================
# Flask 服务器配置
# ============================================
HOST=0.0.0.0
PORT=8890
DEBUG=false

# SQLite 数据库配置
DATABASE_PATH=messages.db

# ============================================
# Milvus 向量数据库配置
# ============================================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=admin123
MILVUS_DATABASE=mildoc
MILVUS_COLLECTION=mildoc_collection
MILVUS_INDEX_NAME=mildoc_index
MILVUS_VECTOR_DIM=768

# ============================================
# MinIO 对象存储配置（用于微信文件上传）
# ============================================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mildoc
MINIO_REGION=minio
MINIO_USE_VIRTUAL_HOST=false
MINIO_USE_SSL=false

# ============================================
# LLM 配置（百炼平台）
# ============================================
LLM_MODEL_NAME=qwen-plus
LLM_API_KEY=<你的百炼平台 API Key>
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# LLM Embedding 配置（百炼平台）
# ============================================
LLM_EMBEDDING_MODEL_NAME=text-embedding-v4
LLM_EMBEDDING_API_KEY=<你的百炼平台 API Key>
LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# Rerank 配置（百炼平台）
# ============================================
RERANK_PROVIDER=dashscope
RERANK_API_KEY=<你的百炼平台 API Key>
RERANK_MODEL_NAME=gte-rerank-v2
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# ============================================
# Langfuse 可观测性（可选）
# ============================================
# LANGFUSE_ENABLE=true
# LANGFUSE_SECRET_KEY=<你的 Langfuse Secret Key>
# LANGFUSE_PUBLIC_KEY=<你的 Langfuse Public Key>
# LANGFUSE_BASE_URL=<你的 Langfuse 服务地址>
