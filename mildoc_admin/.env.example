# mildoc admin - 文献管理后台配置

# ============================================
# MinIO 对象存储配置（本地模式）
# ============================================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mildoc
MINIO_REGION=minio
MINIO_USE_VIRTUAL_HOST=false
MINIO_USE_SSL=false

# 如果使用阿里云 OSS，取消以下注释并注释掉上面的 MinIO 配置
# MINIO_ENDPOINT=oss-cn-hangzhou.aliyuncs.com:443
# MINIO_ACCESS_KEY=<你的阿里云 AccessKey ID>
# MINIO_SECRET_KEY=<你的阿里云 AccessKey Secret>
# MINIO_BUCKET=mildoc
# MINIO_REGION=cn-hangzhou
# MINIO_USE_VIRTUAL_HOST=true
# MINIO_USE_SSL=true

# ============================================
# Milvus 向量数据库配置
# ============================================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=admin123
MILVUS_DATABASE=mildoc
MILVUS_COLLECTION=mildoc_collection
MILVUS_INDEX_NAME=mildoc_index
MILVUS_VECTOR_DIM=768

# ============================================
# 管理后台配置
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 共享上传口令（组内同学共用，用于访问 /share/upload 页面）
SHARE_UPLOAD_PASSPHRASE=<自定义一个口令>

# ============================================
# Flask 配置
# ============================================
FLASK_DEBUG=True
FLASK_SECRET_KEY=<生成一个随机字符串，如: python -c "import secrets; print(secrets.token_hex(24))">
FLASK_HOST=0.0.0.0
FLASK_PORT=8870
