# mildoc index - 文档索引服务配置

# ============================================
# MinIO 对象存储配置（本地模式）
# ============================================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mildoc
MINIO_REGION=minio
MINIO_USE_VIRTUAL_HOST=false
MINIO_USE_SSL=false

# 如果使用阿里云 OSS，取消以下注释并注释掉上面的 MinIO 配置
# MINIO_ENDPOINT=oss-cn-hangzhou.aliyuncs.com:443
# MINIO_ACCESS_KEY=<你的阿里云 AccessKey ID>
# MINIO_SECRET_KEY=<你的阿里云 AccessKey Secret>
# MINIO_BUCKET=mildoc
# MINIO_REGION=oss-cn-hangzhou
# MINIO_USE_VIRTUAL_HOST=true
# MINIO_USE_SSL=true
#
# MNS_ACCESS_KEY_ID=<你的阿里云 AccessKey ID>
# MNS_ACCESS_KEY_SECRET=<你的阿里云 AccessKey Secret>
# MNS_ENDPOINT=https://<你的账号ID>.mns.cn-hangzhou.aliyuncs.com
# MNS_QUEUE_NAME=mildoc-oss-notify

# ============================================
# Milvus 向量数据库配置
# ============================================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=admin123
MILVUS_DATABASE=mildoc
MILVUS_COLLECTION=mildoc_collection
MILVUS_INDEX_NAME=mildoc_index
MILVUS_VECTOR_DIM=768

# ============================================
# LLM Embedding 配置（百炼平台）
# ============================================
OPENAI_API_KEY=<你的百炼平台 API Key>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ENBEDDING_MODEL=text-embedding-v4

# ============================================
# MinerU 高精度文档解析（可选）
# ============================================
# 启用MinerU前，先安装： uv add mineru[core]==2.7.0
# MINERU_SERVER_URL=http://127.0.0.1:8000
